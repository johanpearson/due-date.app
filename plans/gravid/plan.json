  "decisions": [
    {
      "id": "D-stack", "title": "Teknik", "status": "proposed",
      "context": "Appen är liten och ska vara lätt att underhålla och publicera på GitHub Pages.",
      "options": [
        { "name": "Vanilla HTML/CSS/JS", "pros": ["Inget byggsteg", "Snabb, liten", "Enkelt att publicera"], "cons": ["Lite mer manuell DOM-kod"] },
        { "name": "Vite + React/Svelte", "pros": ["Komponenter"], "cons": ["Byggsteg och beroenden för en mycket liten app"] }
      ],
      "chosen": "Vanilla HTML/CSS/JS", "rationale": "Kravet är \"väldigt simpel\"; ingen ram behövs.", "satisfies": ["BR-6"]
    },
    {
      "id": "D-notify", "title": "Hur påminnelser görs utan server", "status": "proposed",
      "context": "Riktiga push-notiser kräver en server. Schemalagda lokala notiser (Notification Triggers) finns inte i webbläsare. iOS visar bara webbnotiser för installerade appar och stöder inte bakgrundssynk.",
      "options": [
        { "name": "Kalenderfil (.ics) per besök", "pros": ["Fungerar överallt", "Påminnelse även när appen är stängd"], "cons": ["Ett extra steg per besök"] },
        { "name": "Lokal notis när appen öppnas / Periodic Background Sync", "pros": ["Inbyggt i appen"], "cons": ["Opålitligt; bakgrundssynk bara i Chrome på Android för installerade appar"] },
        { "name": "Web Push med server", "pros": ["Pålitligt"], "cons": ["Kräver backend – bryter mot GitHub Pages och lokal-bara data"] }
      ],
      "chosen": "Kalenderfil (.ics) per besök", "rationale": "Pålitligast. Lokala notiser läggs till som bonus där de stöds.", "satisfies": ["BR-7"]
    },
    {
      "id": "D-calc", "title": "Beräkningsregel", "status": "proposed",
      "context": "Svensk mödravård räknar BF = SM + 280 dagar (Naegeles regel) och anger graviditetslängd som fullgångna veckor+dagar.",
      "chosen": "SM + 280 dagar; vecka = floor(dagar/7), dag = dagar mod 7. Datum hanteras som lokala kalenderdatum (UTC-midnatt) för att undvika sommartidsfel.",
      "satisfies": ["BR-2", "BR-3", "BR-2-C"]
    }
  ],
  "open_questions": [
